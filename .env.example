# Copy to .env and adjust. .env is git-ignored. Never commit real keys.

# Server
PORT=4000
# SQLite database file (relative to repo root). Use :memory: for an ephemeral DB.
DB_PATH=./data/app.db
# Allowed browser origin for CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# LLM provider (OpenAI-compatible). Leave LLM_API_KEY empty to use the built-in MOCK provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Upload limits
MAX_FILE_SIZE_MB=5
MAX_FILES=10
